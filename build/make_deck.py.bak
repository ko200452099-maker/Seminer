# =========================================================
# 24 — BACKUP 1
# =========================================================
s = blank_slide()
header(s, "BACKUP", "Derivation and assumptions: envelope, indices and the onset-depth model", 24, backup=True)
tf = box(s, 0.62, 1.80, 12.1, 5.0)
for i, (a, b) in enumerate([
    ("CII definition:", "CII = (Saturates + Asphaltenes) / (Resins + Aromatics). Commonly used boundary ≈ 0.9: above it the crude is flagged unstable; below ≈ 0.7 it is generally stable. Thresholds are laboratory-specific."),
    ("De Boer screening:", "plot AOP against bubble point and reservoir pressure. If AOP > Pb, asphaltene problems are likely; if reservoir pressure < AOP, the oil is unstable everywhere and even the reservoir is at risk."),
    ("Onset curve model:", "AOP(T) treated as a fluid-specific curve; in the seminar it is a linear approximation for illustration. The thesis replaces it with a tuned EoS (CPA / PC-SAFT class) matched to measured AOP data."),
    ("Onset-depth model:", "onset depth = depth where flowing pressure P(d) falls below AOP(T(d)). Both profiles are linear approximations here (±); the thesis uses the well's real gradient and multiphase model."),
    ("Sensitivity plan:", "±50–100 bar on AOP, ±10 % on pressure gradient, ±GOR scenarios: the onset depth moves by hundreds of metres — which is precisely why the injection point needs a margin."),
    ("What is deliberately excluded:", "time-dependent deposition growth (first-order only), lower-AOP phenomena, and near-wellbore (formation) damage modelling."),
]):
    p = par(tf, "▪  " + a, size=13.5, bold=True, color=NAVY, first=(i == 0), space_after=2)
    par(tf, b, size=12.5, color=TEXT, space_after=10, line=1.04)
notes(s, "Show only if asked for the maths. The sensitivity line is the most valuable one: it justifies the safety margin on the injection point.")

