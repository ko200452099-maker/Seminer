par(t, "WHY PROACTIVE CHANGES THE ECONOMICS", size=12.5, bold=True, color=TEAL, first=True, space_after=8)
par(t, "No rig-up. No deferred production. No repeat workover cycle. The well keeps producing while the problem is managed continuously — which is why operators increasingly choose inhibition where cleanout frequency would exceed roughly one event per year.",
    size=12.5, color=TEXT, space_after=0, line=1.08)
notes(s, """TARGET 40 s (clock 10:00).
[VERIFY] Ref [7] = dead-oil re-injection mitigation study (Fuel / ScienceDirect, 2020). Ref [4] = dosage numbers from the deepwater case (JPT/SPE 2021).
