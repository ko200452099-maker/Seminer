    ("Delivery: capillary / chemical injection string", "— thin tubing clamped to the production string, injecting continuously at the required depth, with a surface dosing pump and monitoring."),
    ("Dosage is field-specific:", "hundreds to a few thousand ppm; in the documented deepwater case, 750 ppm high-dose initial treatment stabilised to ≈ 500 ppm [4]."),
    ("Placement rule — the lesson of Part 3:", "the injection point must sit DEEPER than the shallowest predicted onset depth; designing it from a rule of thumb leaves tubing unprotected."),
    ("Chemical-free alternative worth noting:", "recycling dead oil into the well to restore solvent quality — promising, still developing [7]."),
]
for i, (a, b) in enumerate(items):
    p = par(tf, "▪  " + a, size=13.5, bold=True, color=NAVY, first=(i == 0), space_after=2)
    par(tf, b, size=12.5, color=TEXT, space_after=7, line=1.03)
